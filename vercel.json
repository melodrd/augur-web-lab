{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "redirects": [
    {"source":"/ryan","destination":"/ryan/","permanent":false},
    {"source":"/augus","destination":"/ryan-augus/","permanent":false},
    {"source":"/augus/","destination":"/ryan-augus/","permanent":false},
    {"source":"/ryan-augus","destination":"/ryan-augus/","permanent":false},
    {"source":"/melo","destination":"/","permanent":false},
    {"source":"/melo/","destination":"/","permanent":false},
    {"source":"/1","destination":"/","permanent":false},
    {"source":"/1/","destination":"/","permanent":false},
    {"source":"/2","destination":"/","permanent":false},
    {"source":"/2/","destination":"/","permanent":false},
    {"source":"/3","destination":"/ryan/","permanent":false},
    {"source":"/3/","destination":"/ryan/","permanent":false},
    {"source":"/4","destination":"/ryan-augus/","permanent":false},
    {"source":"/4/","destination":"/ryan-augus/","permanent":false}
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
    {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},
    {"key":"Content-Security-Policy","value":"frame-ancestors 'none'; base-uri 'self'; object-src 'none'"}
  ]}]
}
