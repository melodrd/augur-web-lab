---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/home/Hero.astro';
import Tenets from '../components/home/Tenets.astro';
import Applications from '../components/home/Applications.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Roadmap from '../components/home/Roadmap.astro';
import LearnMore from '../components/home/LearnMore.astro';
import VersionSwitch from '../components/home/VersionSwitch.astro';
import {createHash} from 'node:crypto';
import {switchInline} from '../components/home/review-inline';
import {pageClass,type HomeVariant} from '../data/homepage-review';
// One composition for "/" and its review copies (owner, 21 Oct 2026): [version].astro renders this page
// as /ryan/, /ryan-augus/ and /melo/ (homepage-review.ts), so the init script below stays one
// chunk. "/" passes no props: v1, indexable, no class. Since 22 Oct 2026 (owner) "/" shows the version
// switch too; with v1's copy gone from the list (26 Oct 2026) it shows "/" as the live homepage, and
// offers the four versions. Its inline style and script are hashed here.
// <main> takes "home-v2" and each reviewer's own class (pageClass).
interface Props { variant?:HomeVariant; noindex?:boolean; }
const {variant='v1',noindex}=Astro.props;
const root=Astro.props.variant===undefined;
if(root){const sha=(text:string)=>`sha256-${createHash('sha256').update(text).digest('base64')}` as const;Astro.csp?.insertStyleHash(sha(switchInline.style));Astro.csp?.insertScriptHash(sha(switchInline.script));}
---
<PageLayout noindex={noindex} class={pageClass(variant)}>
 {root?<Fragment slot="version"><VersionSwitch/></Fragment>:<slot name="version" slot="version"/>}{!root&&<slot name="end" slot="end"/>}<Hero variant={variant}/><Tenets variant={variant}/><Applications variant={variant}/><HowItWorks variant={variant}/><Roadmap variant={variant}/><LearnMore variant={variant}/>
 <script>
  // These sections exist only here, so the page starts them once from one script; each init
  // finds its own sections. One entry instead of five identical ones keeps the JavaScript budget.
  import {initAnswerRibbon,initTenets,initRepZone} from '../motion/home-art';
  import {initHomeInteractions} from '../motion/home-interactions';
  initAnswerRibbon();initTenets();initHomeInteractions();initRepZone();
 </script>
</PageLayout>
