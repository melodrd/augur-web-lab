---
import {createHash} from 'node:crypto';
import Home from './index.astro';
import VersionSwitch from '../components/home/VersionSwitch.astro';
import {switchInline,reviewInline} from '../components/home/review-inline';
import {reviewVersions,type ReviewVersion} from '../data/homepage-review';
// The homepage's review copies; "/" stays the live page. Since 26 Oct 2026 (owner) they are named for whose
// notes they show, in the owner's order: /ryan/, /ryan-augus/ and /melo/ (the list and the copy
// each reads: data/homepage-review.ts; the old /1/ to /4/ redirect in vercel.json). One dynamic route, not
// static pages: Astro writes one build-wide CSP hash list into every page, in route order, and static
// routes would reorder that list on "/" as well. A dynamic route sorts after every static one, just before
// "/", which keeps "/" byte-identical. All are noindex with their own canonical, and all show the version
// switch. Astro.props is typed from getStaticPaths: { variant: ReviewVariant }. The section reveal goes in the
// layout's "end" slot, after the footer, so it finds every section and the footer when it runs.
export function getStaticPaths(){return reviewVersions.map(({version,variant})=>({params:{version},props:{variant}}));}
const {variant}=Astro.props;
const version=Astro.params.version as ReviewVersion;
// Each version renders its sheets and scripts (review-inline.ts).
const inline=reviewInline[variant];
// The streamed CSP meta is emitted before body components render, so every inline string is hashed here.
const sha=(text:string)=>`sha256-${createHash('sha256').update(text).digest('base64')}` as const;
Astro.csp?.insertStyleHash(sha(switchInline.style));Astro.csp?.insertScriptHash(sha(switchInline.script));
inline.styles.forEach(css=>Astro.csp?.insertStyleHash(sha(css)));Object.values(inline.scripts).forEach(js=>Astro.csp?.insertScriptHash(sha(js)));
---
<Home variant={variant} noindex><Fragment slot="version"><VersionSwitch current={version}/>{inline.styles.map(css=><style is:inline set:html={css}></style>)}</Fragment><Fragment slot="end"><script is:inline set:html={inline.scripts.reveal}></script></Fragment></Home>
