---
import { roadmap, roadmapHref, roadmapPaperSquares } from '../../data/roadmap';
import { links } from '../../data/links';
import Icon from '../primitives/Icon.astro';
import {homeCopy,type HomeVariant} from '../../data/homepage-review';
import {reviewInline} from './review-inline';
// A review version may set its own two-line heading (`roadmap.heading`; Augus's "Coming soon?",
// homepage-v4.ts). Every other page keeps the literal one, so "/" is unchanged.
// On the review copies the section reveal (reveal-v2.js) settles in the heading and the lead, and the track's entrance
// follows the lead: roadmap-v2.js plays it and the picker's motion, so the track carries data-roadmap-v2 there and
// home-interactions.ts, which looks for data-roadmap, binds only "/".
interface Props { variant?:HomeVariant; }
const {variant='v1'}=Astro.props;const copy=homeCopy(variant);
const heading=copy&&'roadmap' in copy?copy.roadmap.heading:undefined;
const review=copy!==undefined,reveal=review?'':undefined;
---
<section class="roadmap section" id="roadmap" aria-labelledby="roadmap-heading"><div class="container">
 <div class="section-heading"><h2 id="roadmap-heading" data-reveal={reveal}>{heading?<>{heading[0]}<br/>{heading[1]}</>:<>The road to<br/>Augur Lituus.</>}</h2><p class="lead" data-reveal={reveal}>The research is published and the build is underway.</p></div>
 <div class="roadmap-track" data-tabs data-roadmap={review?undefined:''} data-roadmap-v2={reveal} data-activation="manual" data-active="3" style="--selected:3">
  <div class="roadmap-phases" aria-hidden="true"><span>Completed</span><span>In progress</span><span>Up next</span></div>
  <div class="roadmap-tabs" role="tablist" aria-label="Augur roadmap">
   <div class="selected-tab" aria-hidden="true"></div><div class="roadmap-done" data-track-done aria-hidden="true"></div><div class="roadmap-live" data-track-live aria-hidden="true"></div><div class="roadmap-ahead" data-track-ahead aria-hidden="true"></div>
   {roadmap.map((milestone,i)=><button type="button" role="tab" id={`roadmap-tab-${milestone.id}`} aria-controls={`roadmap-panel-${milestone.id}`} aria-selected={i===3?'true':'false'} tabindex={i===3?0:-1}><span class:list={['roadmap-stop',{'is-completed':i<3,'is-now':i===3}]} data-stop aria-hidden="true">{i<3&&<Icon name="check"/>}</span><span class="roadmap-date">{milestone.date}</span><span class="roadmap-label"><span class="button-label">{milestone.label}</span></span><span class="roadmap-plus" aria-hidden="true"><Icon name="plus"/></span></button>)}
  </div>
  <div class="roadmap-panels">{roadmap.map((milestone,i)=><div class="roadmap-panel" role="tabpanel" id={`roadmap-panel-${milestone.id}`} aria-labelledby={`roadmap-tab-${milestone.id}`} hidden={i!==3} tabindex="0">
   <div class="roadmap-story"><p class:list={['roadmap-status',{'is-done':i<3,'is-now':i===3,'is-pending':i>3}]}>{i<3?<Icon name="check"/>:<span aria-hidden="true"></span>}{milestone.status}</p><h3>{milestone.title}</h3><p class="roadmap-body">{milestone.body}</p><div class="roadmap-links">{milestone.links.map(link=><a class="button text" href={roadmapHref(link)}><span class="button-label">{link.label}</span>{link.key&&<Icon name="arrow-up-right"/>}</a>)}</div></div>
   <div class="roadmap-evidence" data-evidence={milestone.evidence}>
    {milestone.evidence==='reboot'&&<><p class="evidence-label">From the blog</p><a class="evidence-post line-link" href={links.reboot.url}><strong class="button-label">Augur Reboot 2025 Roadmap</strong><span>1 April 2025<Icon name="arrow-up-right"/></span></a><a class="evidence-post line-link" href={links.generalized.url}><strong class="button-label">Generalized Augur</strong><span>13 May 2025<Icon name="arrow-up-right"/></span></a></>}
    {milestone.evidence==='paper'&&<><p class="evidence-label">The paper</p><div class="paper-evidence"><svg class="paper-cover" width="104" height="100" viewBox="0 18 104 100" aria-hidden="true"><rect x=".5" y=".5" width="103" height="135" fill="var(--background)" stroke="var(--web-outline)"/>{roadmapPaperSquares.map(([x,y,green])=><rect x={x} y={y} width="3" height="3" fill={green?'var(--primary)':'var(--foreground)'} opacity={green?1:.35}/>)}<text x="14" y="79" fill="var(--foreground)" font-family="var(--font-heading)" font-size="13" font-weight="600"><tspan>Augur</tspan><tspan x="14" dy="16">Lituus</tspan></text></svg><div><strong>Augur Lituus Whitepaper</strong><p>PDF · January 2026</p><p>AugurProject/whitepaper on GitHub</p></div></div></>}
    {milestone.evidence==='fork'&&<><p class="evidence-label">REP migrated, by universe</p><div class="evidence-stat"><span>Yes universe</span><strong>6,398,081 REP</strong><div class="evidence-bar"><span class="is-accent" style="width:100%" data-evidence-bar></span></div></div><div class="evidence-stat"><span>No universe</span><strong>1,786 REP</strong><div class="evidence-bar"><span style="width:.028%;min-width:2px" data-evidence-bar></span></div></div><p class="evidence-caption">6.4 million REP in total, about 58.2% of the original 11 million supply. Fork report, 5 August 2026.</p></>}
    {milestone.evidence==='tests'&&<><p class="evidence-label">Automated tests in the implementation</p><div class="evidence-stat"><span>Start of the quarter</span><strong>About 40</strong><div class="evidence-bar"><span style="width:13.33%" data-evidence-bar></span></div></div><div class="evidence-stat"><span>End of the quarter</span><strong>300+</strong><div class="evidence-bar"><span class="is-accent" style="width:100%" data-evidence-bar></span></div></div><p class="evidence-caption">Across 22 merged pull requests. Q2 2026 report, 1 October 2026.</p></>}
    {milestone.evidence==='goals'&&<><p class="evidence-label">Goals for the coming quarter</p><ul class="evidence-goals"><li>Continue implementation and testing</li><li>Publish a plain-language walkthrough of Augur Lituus</li></ul><p class="evidence-caption">Q2 2026 report, 1 October 2026.</p></>}
    {milestone.evidence==='quote'&&<><span class="quote-mark" aria-hidden="true">“</span><blockquote>A whitepaper does not resolve markets by itself; the design has to be implemented, tested, audited, documented, and made usable.</blockquote><p class="evidence-caption">From “Augur Is Testing Its Past and Building Its Future”, 21 July 2026.</p></>}
   </div>
  </div>)}</div>
 </div>
</div></section>{review&&<script is:inline set:html={reviewInline.v2.scripts.roadmap}></script>}
<style>
/* Phase brackets span their columns exactly, so their ticks meet the selected stop's box edges and the track's ends; the current phase's bracket is Green like the box's top (owner, 19 Oct 2026). */
 .roadmap{padding-top:64px;padding-bottom:96px}.roadmap>.container{padding-top:72px}.section-heading{margin-bottom:48px}.roadmap-phases{display:grid;grid-template-columns:3fr 1fr 2fr;gap:0;padding-right:0;margin-bottom:12px;font:600 14px/20px var(--font-heading);color:var(--muted-foreground)}.roadmap-phases>span{padding-right:0}.roadmap-phases>span::after{display:block;content:'';height:6px;margin-top:10px;border-top:1px solid var(--web-outline);border-left:1px solid var(--web-outline)}.roadmap-phases>span:last-child::after{border-right:1px solid var(--web-outline)}.roadmap-phases>span:nth-child(2)::after{border-color:var(--primary);border-right:1px solid var(--primary)}.roadmap-phases>span:nth-child(3)::after{border-left:0}.roadmap-phases>span:nth-child(2){color:var(--primary)}.roadmap-tabs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));position:relative}.roadmap-tabs button{position:relative;z-index:1;min-width:0;height:144px;padding:32px 20px 28px;border:0;background:transparent;color:var(--foreground);text-align:left;display:flex;flex-direction:column;align-items:flex-start;cursor:pointer}.roadmap-stop{display:block;width:12px;height:12px;border:1.5px solid var(--mark-participant,#71728A);background:var(--background);margin:2px 0 24px 2px;flex-shrink:0}.roadmap-stop.is-completed{border-color:var(--primary);background:var(--primary)}.roadmap-stop.is-now{width:16px;height:16px;margin:0 0 22px;background:var(--primary);border:0;outline:1px solid color-mix(in srgb,var(--primary),transparent 65%);outline-offset:8px}.roadmap-date{font:400 14px/20px var(--font-body);color:var(--muted-foreground);white-space:nowrap}.roadmap-tabs button:nth-of-type(4) .roadmap-date{color:var(--primary)}.roadmap-label{font:600 16px/22px var(--font-heading);margin-top:4px;padding-right:25px;white-space:nowrap}.roadmap-plus{position:absolute;right:20px;top:96px;display:grid;place-items:center;width:20px;height:20px;border:1px solid var(--web-outline)}.roadmap-plus :global(.web-icon),.roadmap-plus :global(svg){width:12px;height:12px}
 /* Unselected stops answer the pointer like the other picker rows. */
 .roadmap-tabs button:not([aria-selected="true"]):hover .button-label::after{transform:none}.roadmap-tabs button:not([aria-selected="true"]):hover .roadmap-plus{border-color:var(--web-hover-edge);background:var(--web-raised)}.roadmap-plus{transition:border-color 180ms ease-out,background-color 180ms ease-out}.roadmap-tabs button:focus-visible{outline-offset:-2px}.roadmap-tabs button[aria-selected="true"] .roadmap-plus{display:none}.selected-tab{position:absolute;top:0;bottom:-1px;left:0;width:calc(100% / 6);transform:translateX(calc(var(--selected) * 100%));background:var(--web-quiet);border:1px solid var(--web-outline);border-top:2px solid var(--primary);border-bottom:0;transition:transform calc(320ms * var(--motion-factor,1)) cubic-bezier(.22,.61,.36,1)}.roadmap-done,.roadmap-ahead{position:absolute;top:39px;left:0;height:2px;transform-origin:left}.roadmap-done{width:calc(50% + 28px);background:var(--primary)}.roadmap-ahead{left:calc(50% + 28px);right:0;border-top:2px dashed var(--mark-past,#4A4B61)}.roadmap-panels{background:var(--web-quiet);border:1px solid var(--web-outline)}.roadmap-panel{min-height:356px;display:grid;grid-template-columns:minmax(0,1fr) 480px;gap:64px;padding:48px}.roadmap-panel[hidden]{display:none}.roadmap-status{display:flex;align-items:baseline;gap:10px;color:var(--muted-foreground);font-size:14px;line-height:20px;margin:0 0 20px}.roadmap-status>span{width:8px;height:8px;background:var(--primary);flex-shrink:0}.roadmap-story h3{font:600 24px/32px var(--font-heading);margin:0 0 20px}.roadmap-body{font-size:18px;line-height:28px;margin:0;max-width:540px}.roadmap-links{display:flex;gap:24px;flex-wrap:wrap;margin-top:20px}.roadmap-evidence{border:1px solid var(--web-outline);padding:24px 28px;background:var(--web-tile);align-self:start;min-width:0}.evidence-label,.evidence-caption{font-size:13px;line-height:18px;color:var(--muted-foreground);margin:0}.evidence-label{margin-bottom:22px}.evidence-stat{display:grid;grid-template-columns:1fr auto;align-items:baseline;gap:8px;margin-bottom:20px}.evidence-stat>span{font-size:14px;line-height:20px;color:var(--muted-foreground)}.evidence-stat>strong{font:600 20px/26px var(--font-heading)}.evidence-bar{height:12px;grid-column:1/-1;background:var(--background)}.evidence-bar>span{display:block;height:100%;background:var(--mark-past,#4A4B61);transform-origin:left}.evidence-bar>span.is-accent{background:var(--primary)}.roadmap-status.is-pending>span{background:transparent;border:1px solid var(--mark-participant)}.roadmap-evidence:is([data-evidence="reboot"],[data-evidence="paper"],[data-evidence="goals"]) .evidence-label{font-size:14px;line-height:20px;margin-bottom:20px}.evidence-post{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 0;color:var(--foreground);text-decoration:none;border-top:1px solid var(--web-outline)}.evidence-post:last-child{border-bottom:1px solid var(--web-outline)}.evidence-post strong{font:600 15px/22px var(--font-heading)}.evidence-post>span{font-size:14px;line-height:20px;color:var(--muted-foreground);white-space:nowrap}.evidence-post>span{display:inline-flex;align-items:center;gap:6px}.evidence-post>span :global(.web-icon),.evidence-post>span :global(svg){width:14px;height:14px}.paper-evidence{display:flex;align-items:center;gap:24px;height:100px}.paper-cover{width:104px;height:100px;flex-shrink:0}.paper-evidence strong{font:600 18px/24px var(--font-heading)}.paper-evidence p{font-size:14px;line-height:20px;color:var(--muted-foreground);margin:6px 0 0}.evidence-goals{padding:0;margin:0 0 20px;font-size:16px;line-height:24px;list-style:none}.evidence-goals li{position:relative;padding:14px 0 14px 26px;border-top:1px solid var(--web-outline)}.evidence-goals li:last-child{border-bottom:1px solid var(--web-outline)}.evidence-goals li::before{content:'';position:absolute;left:0;top:21px;width:10px;height:10px;border:1px solid var(--mark-participant)}.roadmap-evidence:is([data-evidence="goals"],[data-evidence="quote"]) .evidence-caption{line-height:20px}.quote-mark{display:block;height:40px;color:var(--primary);font:600 40px/40px var(--font-heading);margin-bottom:4px}.roadmap-evidence blockquote{font:400 20px/30px var(--font-heading);margin:0 0 20px}
 /* Past milestones are done, not alive (owner feedback, 6 Oct 2026): their leg of the
    track turns Graphite, their stops become checked squares and their labels recede to
    Pewter until hovered or selected. Only the current leg and Now stay Green, and Now
    carries a slow live pulse. The future stays dashed. */
 .roadmap-done{background:var(--mark-past,#4A4B61)}
 .roadmap-live{position:absolute;top:39px;left:calc(100% / 3 + 28px);width:calc(100% / 6);height:2px;background:var(--primary);transform-origin:left}
 .roadmap-stop.is-completed{display:grid;place-items:center;width:16px;height:16px;margin:0 0 22px;background:var(--mark-past,#4A4B61);border:0;color:var(--foreground)}
 .roadmap-stop.is-completed :global(.web-icon),.roadmap-stop.is-completed :global(svg){width:10px;height:10px}
 .roadmap-tabs button:has(.is-completed) .roadmap-label{color:var(--muted-foreground);transition:color 180ms ease-out}
 .roadmap-tabs button:has(.is-completed):is(:hover,[aria-selected="true"]) .roadmap-label{color:var(--foreground)}
 .roadmap-tabs button:has(.is-completed):not(:hover) .roadmap-plus{border-color:var(--mark-past,#4A4B61);color:var(--muted-foreground)}
 .roadmap-stop.is-now{position:relative}
 .roadmap-stop.is-now::after{content:'';position:absolute;inset:-9px;border:1px solid var(--primary);opacity:0;pointer-events:none}
 @media(prefers-reduced-motion:no-preference){.roadmap-stop.is-now::after{animation:roadmap-live 2.4s cubic-bezier(.22,.61,.36,1) infinite}}
 @keyframes roadmap-live{0%{opacity:.8;transform:scale(.5)}70%,100%{opacity:0;transform:scale(1.35)}}
 .roadmap-status.is-done{color:var(--muted-foreground)}.roadmap-status.is-done :global(.web-icon),.roadmap-status.is-done :global(svg){width:12px;height:12px;align-self:center;color:var(--muted-foreground)}
 .roadmap-status.is-now>span{position:relative}
 .roadmap-status.is-now>span::after{content:'';position:absolute;inset:-5px;border:1px solid var(--primary);opacity:0}
 @media(prefers-reduced-motion:no-preference){.roadmap-status.is-now>span::after{animation:roadmap-live 2.4s cubic-bezier(.22,.61,.36,1) infinite}}
 @media(forced-colors:active){.roadmap-done{background:GrayText}.roadmap-live{background:Highlight}}
 @media(max-width:1279px){.roadmap-tabs button{padding-inline:12px}.roadmap-label{font-size:14px;white-space:normal}.roadmap-date{font-size:12px}.roadmap-plus{right:12px}.roadmap-panel{padding:36px;gap:40px}.roadmap-evidence{padding:24px}.roadmap-body{font-size:17px;line-height:27px}}
 @media(max-width:1023px){.roadmap-panel{grid-template-columns:1fr;gap:32px;min-height:630px}.roadmap-evidence{width:100%;max-width:560px}.roadmap-tabs button{height:155px}.roadmap-phases{font-size:12px}.roadmap-date{white-space:normal}.roadmap-plus{top:124px}.roadmap-label{padding-right:0}}
 @media(max-width:767px){.roadmap{padding-block:40px 64px}.roadmap>.container{padding-top:48px}.roadmap-phases{display:none}.roadmap-tabs{grid-template-columns:1fr;gap:8px}.roadmap-tabs button{height:auto;min-height:72px;padding:16px 48px 16px 44px;background:var(--web-quiet);border-left:2px solid transparent;display:block}.roadmap-tabs button[aria-selected="true"]{border-color:var(--primary);background:var(--web-tile)}.selected-tab,.roadmap-done,.roadmap-live,.roadmap-ahead{display:none}.roadmap-stop,.roadmap-stop.is-now{position:absolute;left:18px;top:30px;margin:0}.roadmap-stop.is-now{width:12px;height:12px;outline-offset:4px}.roadmap-date{display:block;font-size:13px}.roadmap-label{display:block;font-size:16px}.roadmap-plus{top:32px;right:20px}.roadmap-panel{padding:28px 24px;min-height:720px}.roadmap-panels{margin-top:24px}.roadmap-status{font-size:12px}.roadmap-evidence{padding:20px}.evidence-stat>strong{font-size:17px}.evidence-stat>span{font-size:13px}.roadmap-evidence blockquote{font-size:17px;line-height:27px}.evidence-post{align-items:flex-start;flex-direction:column;gap:4px}.paper-evidence{gap:16px}.paper-cover{width:80px}.paper-evidence strong{font-size:15px;line-height:22px}.paper-evidence p{font-size:11px;line-height:18px}}
 @media(prefers-reduced-motion:reduce){.selected-tab{transition:none}}
</style>
