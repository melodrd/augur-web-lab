---
import { walkthrough, query, ledger, holder, stakesAt, amount, rep } from '../../data/walkthrough';
import Icon from '../primitives/Icon.astro';
import Button from '../primitives/Button.astro';
import RepFlow from '../art/RepFlow.astro';
import {homeCopy,ownerVersion,type HomeVariant} from '../../data/homepage-review';
import {howScenes} from '../../data/how-scenes';
import type {SvgNode} from '../../data/iso-kit';
import {reviewScripts,reviewInline} from './review-inline';
// A review version (v2, v3, v4) renders its own copy (homepage-review.ts); 'v1', the default and every
// "/" use, stays byte-identical. All three share v2's collapsed example below (`review`).
// v2 (Ryan 12) keeps the heading and puts the example behind a click: a one-line lead, a "Walk through
// an example" toggle and the four steps as a strip, each opening the example at its step. The example
// is v1's markup minus the scroll pin: without data-walkthrough-track and the run under it,
// walkthrough-scroll.ts never binds, so nothing reads or drives the example while it is closed. Its
// open and close script and every v2 rule are review-only strings (review-inline.ts, home-v2.css).
interface Props { variant?:HomeVariant; }
const {variant='v1'}=Astro.props,copy=homeCopy(variant),review=copy!==undefined,how=copy?.howItWorks,holderCopy=copy?copy.holder:holder;
const { outcomes } = query;
// One square per bond-sized unit (a report's bond, 15 REP), as in the REP panel: a challenge
// shows two. Each square remembers the Activity entry that staked it, so a step forward drops
// in only the bonds that step added.
const bondSquares = (step: number, outcome: string) => ledger.slice(0, step + 1).flatMap((entry, at) => entry.stake === outcome ? Array.from({ length: entry.amount! / rep.bond }, () => at) : []);
// /2/ (owner, 25 Oct 2026, item 4: "build A on /2", sketch A of the item 4 board; 29 Oct 2026, sketch B of the How
// it works board): the four steps as a vertical tablist beside one Navy stage, the shared tabs controller's markup
// (tabs.ts). Each step's rail is the link down to the next step. Each step's panel holds its scene of a question's
// life (how-scenes.ts, drawn here at rest like IsoScene.astro's) over the claim and a body line; then the section's
// one button, which opens one question's story in a Navy card (four sentences,
// each under its step's name), then Holding REP. how-path-v2.js adds hover and the stage's motion, and runs the
// button. The example's question, amounts and answers come from walkthrough.ts (one source), with a no-break space
// before "REP"; it has no foot (owner, 29 Oct 2026: the whitepaper note went). Every other version renders the
// markup further down. The section reveal (reveal-v2.js) settles in the heading, the lead and Holding REP; the steps
// and the stage stay put: once the lead has landed, how-path-v2.js draws “paid” in the heading, then plays the shown step's scene.
const path=ownerVersion(variant)&&how&&'path' in how?how.path:undefined;
const [,reported,challenged]=ledger,finalAnswer=walkthrough[walkthrough.length-1]!.outcome;
const reps=(value:number)=>`${value} REP`;
const values:Record<string,string>={fee:reps(rep.fee),bond:reps(rep.bond),challenge:reps(rep.challenge),share:reps(rep.share),burned:reps(rep.burned),reported:reported!.stake!,challenged:challenged!.stake!,final:finalAnswer!,question:query.title};
// The example's sentences (homepage-v2.ts): {name} is the value, **…** bold, and {+name} the value bold in Green
// ({+words} with no such value sets the words themselves, as {+the reward}).
const value=(text:string)=>text.replace(/\{(\w+)\}/g,(token,name:string)=>values[name]??token);
const story=(text:string)=>text.split(/(\*\*.+?\*\*|\{\+[^}]+\})/).filter(Boolean).map(part=>part.startsWith('**')?{value:value(part.slice(2,-2)),win:false}:part.startsWith('{+')?{value:values[part.slice(2,-1)]??part.slice(2,-1),win:true}:value(part));
---
<section class="how-it-works section" id="how-it-works" aria-labelledby="how-heading" data-how-v2={review?'':undefined}><div class="container">
 {path?<Fragment>
 <div class="section-heading"><h2 id="how-heading" data-paid-heading data-reveal>Know what happened?<br/>Get <span class="paid">paid<span class="paid-mark" aria-hidden="true"></span></span> to report it.</h2><p class="lead" data-reveal>{path.lead}</p></div>
 <div class="how-path" data-tabs data-how-path data-panel-swap data-activation="automatic" data-active="0">
  <div class="how-path-tabs" role="tablist" aria-orientation="vertical" aria-label={path.label}>{path.stops.map((stop,i)=><button type="button" role="tab" id={`how-tab-${stop.scene}`} aria-controls={`how-panel-${stop.scene}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} class="how-path-tab" aria-labelledby={`how-tab-${stop.scene}-name`} aria-describedby={`how-tab-${stop.scene}-note`}><span class="how-path-rail" aria-hidden="true" data-how-rail></span><span class="how-path-index" aria-hidden="true">{i+1}</span><span class="how-path-name" id={`how-tab-${stop.scene}-name`}>{stop.title}</span><span class="how-path-note" id={`how-tab-${stop.scene}-note`}>{stop.note}</span></button>)}</div>
  <div class="how-path-stage">{path.stops.map((stop,i)=><div role="tabpanel" id={`how-panel-${stop.scene}`} aria-labelledby={`how-tab-${stop.scene}`} class="how-path-panel" tabindex="0" hidden={i!==0} data-how-step={stop.scene}><svg viewBox="0 0 336 168" width="336" height="168" class="how-scene" data-how-scene={stop.scene} aria-hidden="true"><g transform={howScenes.transform}>{(function render(nodes:SvgNode[]):any{return nodes.map(({tag,attrs,children})=>{const Tag=tag as any;return children?<Tag {...attrs}>{render(children)}</Tag>:<Tag {...attrs}/>;});})(howScenes.worlds[stop.scene])}</g></svg><div class="how-path-words"><p class="how-claim"><span class="setup">{stop.claim[0]}</span><span>{stop.claim[1]}</span></p><p class="how-body">{stop.body}</p></div></div>)}</div>
 </div>
 <button type="button" class="button outline how-toggle how-more" aria-expanded="true" aria-controls="how-example" data-how-more hidden><span class="how-toggle-open">{how!.open}</span><span class="how-toggle-close">{how!.close}</span><Icon name="chevron-down"/></button>
 <div class="path-example" id="how-example" data-how-demo>
  <div class="example" role="region" aria-label={path.example.label}>
   <ol class="example-story">{path.example.story.map((text,i,all)=><li class:list={['example-step',{'is-you':i===all.length-1}]} data-example-row><span class="example-name">{path.stops[i]!.title}</span><p class="example-line">{story(text).map(part=>typeof part==='string'?part:<strong class:list={{'is-win':part.win}}>{part.value}</strong>)}</p></li>)}</ol>
  </div>
 </div>
 <div class:list={['holding',{'has-labels':holderCopy.points.some(point=>'label' in point)}]} data-reveal><div class="holding-head"><h3 class="holding-title">{holderCopy.title}</h3>{'link' in holderCopy?<Button href="/rep/" variant="outline">{holderCopy.link}</Button>:<Button href="/rep/" variant="text">Learn about REP</Button>}</div><ul class="holding-points">{holderCopy.points.map(point=><li class:list={['holding-point',{'is-act':'act' in point,'is-earn':'earn' in point}]}>{'label' in point?<span class="holding-label">{point.label}</span>:<i class="holding-mark" aria-hidden="true"></i>}<p>{'lead' in point&&<Fragment><strong>{point.lead}</strong> </Fragment>}{point.text}</p></li>)}</ul></div>
 </Fragment>:<Fragment>
 <div class="section-heading"><h2 id="how-heading" data-paid-heading>Know what happened?<br/>Get <span class="paid">paid<span class="paid-mark" aria-hidden="true"></span></span> to report it.</h2>{how?<p class="lead">{how.lead}</p>:<p class="lead">Every Augur Lituus answer comes from someone with REP at stake. Report the right outcome first to earn the reward, or challenge a wrong one to win 80% of its bond. A wrong call costs your bond.</p>}{how&&<button type="button" class="button outline how-toggle" aria-expanded="false" aria-controls="how-demo" data-how-toggle hidden><span class="how-toggle-open">{how.open}</span><span class="how-toggle-close">{how.close}</span><Icon name="chevron-down"/></button>}</div>{how&&<ol class="how-strip" aria-label={how.steps} data-how-strip hidden>{walkthrough.map((step,i)=><li><button type="button" class="how-step" aria-controls="how-demo" aria-expanded="false" data-how-step={i}><span class="how-step-index" aria-hidden="true">{i+1}</span><span class="how-step-title">{step.title}</span></button></li>)}</ol>}
 <div class="walkthrough-track" data-walkthrough-track={review?undefined:''} id={review?'how-demo':undefined} data-how-demo={review?'':undefined}>
 <div class="walkthrough" data-tabs data-walkthrough data-panel-swap data-active="0">
  <div class="walkthrough-steps" role="tablist" aria-label="How taking part works" aria-orientation="vertical">
   {walkthrough.map((step,i)=><button type="button" role="tab" id={`walkthrough-tab-${i}`} aria-label={step.title} aria-controls={`walkthrough-panel-${i} walkthrough-rep-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><span class="step-head"><span class="step-title">{step.title}</span><span class="step-done" aria-hidden="true"><Icon name="check"/></span></span><span class="step-description">{step.description}</span></button>)}
  </div>
  <div class="rep-panels">
   {walkthrough.map((step,i)=><div class="rep-panel" role="group" id={`walkthrough-rep-${i}`} aria-label={step.zone.label} hidden={i!==0}><RepFlow zone={step.zone}/></div>)}
  </div>
  <div class="query-panels">
   {walkthrough.map((step,i)=><div class="query-card" role="tabpanel" id={`walkthrough-panel-${i}`} aria-labelledby={`walkthrough-tab-${i}`} hidden={i!==0} tabindex="0" style={`--connector-top:${40+i*70}px`}>
    <div class="query-header"><strong class="query-name">Augur Lituus</strong><span class:list={["query-status",`is-${step.state}`]}>{step.state==='final'?<Icon name="check"/>:<span class="status-dot" aria-hidden="true"></span>}{step.status}</span></div>
    <div class="query-body"><h3>{query.title}</h3><p class="query-cutoff">Information cutoff <time datetime={query.cutoffIso}>{query.cutoffDate}</time></p><details class="query-details"><summary class="line-link">{!ownerVersion(variant)&&<Icon name="list-checks"/>}<span class="button-label">Question details</span><Icon name="chevron-down"/></summary><div class="details-body"><section class="details-field"><h4 class="details-label">Description</h4>{query.description.map(text=>{const [outcome,...rest]=text.split(" ");return <p><strong>{outcome}</strong> {rest.join(" ")}</p>;})}</section><section class="details-field"><h4 class="details-label">Resolution criteria</h4><ol class="details-criteria" role="list">{query.criteria.map(text=><li>{text}</li>)}</ol></section><p class="details-unix">Cutoff in Unix time <span>{query.cutoffUnix}</span></p></div></details>
     {(()=>{const stakes=stakesAt(i),total=stakes.reduce((sum,part)=>sum+part.value,0),standing=step.outcome?outcomes.indexOf(step.outcome):-1;return <div class="query-outcomes"><div class="outcomes-head"><p id={`walkthrough-outcomes-${i}`}>{step.answerLabel}</p>{total>0&&<p class="stakes-total"><strong>{amount(total)}</strong> staked</p>}</div>
      <div class:list={['outcome-board',{'is-final':step.state==='final'}]} style={standing>=0?`--standing:${standing}`:undefined}><ul class="outcome-list" aria-labelledby={`walkthrough-outcomes-${i}`}>{outcomes.map(outcome=>{const picked=step.outcome===outcome,other=!!step.outcome&&!picked,out=other&&step.state==='final',value=stakes.find(part=>part.outcome===outcome)?.value??0,bonds=bondSquares(i,outcome);return <li class:list={['outcome-tile',{'is-selected':picked,'is-other':other&&!out,'is-out':out}]} data-out={out?'':undefined}><span class="outcome-head"><span class="outcome-name">{out?<><s>{outcome}</s><span class="sr-only"> — ruled out</span></>:outcome}{picked&&<span class="sr-only"> — {step.answerLabel.toLowerCase()}</span>}</span>{picked&&<span class="outcome-check" aria-hidden="true"><Icon name="check"/></span>}</span><span class="outcome-bonds" aria-hidden="true">{bonds.length?bonds.map(at=><i data-bond-at={at}></i>):<i class="is-empty"></i>}</span><span class:list={['outcome-stake',{'is-zero':!value}]}>{amount(value)}</span></li>;})}</ul>{standing>=0&&<span class="standing-frame" aria-hidden="true" data-standing={standing}></span>}</div></div>;})()}
    </div>
    <div class="query-activity"><h4 class="ledger-label" id={`walkthrough-ledger-${i}`}>Activity</h4><ol class="query-ledger" aria-labelledby={`walkthrough-ledger-${i}`}>{ledger.slice(0,i+1).map((entry,index)=>({entry,index})).reverse().map(({entry,index})=>{const replaced=entry.replacedAt!==undefined&&i>=entry.replacedAt;return <li data-ledger-current={index===i?'':undefined} data-replaced-at={replaced?entry.replacedAt:undefined}><span class="ledger-node" aria-hidden="true"></span><span class="ledger-title">{replaced?<><s>{entry.event}</s><span class="sr-only"> (replaced by the challenge)</span></>:entry.event}{entry.you&&<span class="ledger-you">You</span>}</span>{entry.amount!==undefined&&<span class="ledger-amount"><strong>{amount(entry.amount)}</strong> {entry.stake?'bond':'fee'}</span>}</li>;})}</ol></div>
   </div>)}
  </div>
 </div>
 {!review&&<div class="walkthrough-run" aria-hidden="true"></div>}
 </div>
 <div class="holder">
  <h3>{holderCopy.title}</h3>
  <ul class="holder-points">{holderCopy.points.map((point,i)=><li><i class:list={['holder-mark',{'is-action':i===1}]} aria-hidden="true"></i><span><strong>{'lead' in point?point.lead:''}</strong> {point.text}</span></li>)}</ul>
  <Button href="/rep/" variant="text">Learn about REP</Button>
 </div>
 </Fragment>}
</div></section>{review&&!path&&<script is:inline set:html={reviewScripts.how}></script>}{path&&<script is:inline set:html={reviewInline.v2.scripts.howPath}></script>}
<style>
 /* One section answers “How do I take part, and how do I get paid?” (owner + Augus, 19 Oct 2026).
    The left column is yours: each step says what you do and its “Your REP” panel, right under
    the steps, what you get. The right column is only the example query, so the explanation
    never reads as product UI (owner, 19 Oct 2026). The REP section that repeated steps 2–3 is
    folded in; its holder note is the row under the walkthrough. */
 .how-it-works{background:var(--web-band);padding-block:96px}.section-heading{margin-bottom:48px}
 /* “paid” is the promise, so it keeps a Green underline; it draws in once per visit as the
    heading scrolls into view (home-interactions.ts) and is simply there otherwise. */
 .paid{position:relative;display:inline-block}
 .paid-mark{position:absolute;left:0;right:0;bottom:.02em;height:.1em;min-height:3px;background:var(--primary);transform-origin:left}
 .walkthrough{display:grid;grid-template-columns:minmax(0,500fr) minmax(0,668fr);grid-template-rows:auto 1fr;grid-template-areas:"steps panels" "rep panels";column-gap:80px;row-gap:24px;position:relative}
 /* Scrolling steps through it (owner, 19 Oct 2026): where it fits the screen, the walkthrough pins
    while the page scrolls past a run under it, and the step follows the scroll
    (walkthrough-scroll.ts sets the run, the pin and is-pinned). Elsewhere the run is empty. */
 .walkthrough-run{height:0}
 .walkthrough-track.is-pinned .walkthrough{position:sticky;top:var(--pin-top,24px)}
 .walkthrough-track.is-pinned .walkthrough-run{height:var(--pin-run,0)}
 @media print{.walkthrough-track.is-pinned .walkthrough{position:relative}.walkthrough-track.is-pinned .walkthrough-run{height:0}}
 /* A step's tab controls its card and its REP panel together (aria-controls lists both). The
    four panels share one grid cell like the cards, so the panel keeps one height. */
 .rep-panels{grid-area:rep;display:grid;align-self:start;min-width:0}.rep-panel{grid-area:1/1;min-width:0}.rep-panel[hidden]{display:block!important;visibility:hidden}
 .walkthrough-steps{grid-area:steps;display:flex;flex-direction:column;gap:8px}.walkthrough-steps button{display:flex;flex-direction:column;align-items:flex-start;text-align:left;background:var(--background);color:var(--foreground);border:0;padding:18px 24px;min-height:62px;cursor:pointer;transition:background 180ms ease-out,color 180ms ease-out}.step-title{font:600 20px/26px var(--font-heading)}.step-description{display:grid;grid-template-rows:0fr;max-height:0;opacity:0;overflow:hidden;font:400 16px/24px var(--font-body);transition:max-height calc(320ms * var(--motion-factor,1)),opacity calc(320ms * var(--motion-factor,1)),margin calc(320ms * var(--motion-factor,1))}.walkthrough-steps button[aria-selected="true"]{background:var(--primary);color:var(--background);padding-block:24px}.walkthrough-steps button[aria-selected="true"] .step-title{font-size:24px;line-height:32px}.walkthrough-steps button[aria-selected="true"] .step-description{max-height:150px;opacity:1;margin-top:12px}.walkthrough-steps button:hover:not([aria-selected="true"]){background:var(--web-raised)}.walkthrough-steps button:hover:not([aria-selected="true"]):not(:focus-visible){outline:1px solid var(--web-hover-edge);outline-offset:-1px}
 /* Every step's card shares one grid cell, hidden ones kept in layout but invisible, and each
    card is a subgrid of the same three rows (header, question with outcomes, Activity), so every
    row is as tall as its tallest step at any width: switching never moves the page, and spare
    room falls under the Activity list at the card's foot
    (overrides the global [hidden] rule for these cards only).
    Each fact has one home (owner, 19 Oct 2026: “too noisy”): the steps say where we are, so the
    card has no progress bar; the status chip says what is happening now, so Activity is only
    history; the outcome rows carry the stakes, so there is no separate Stakes block. */
 .query-panels{grid-area:panels;display:grid;grid-template-rows:auto auto 1fr;min-width:0}
 .query-card{grid-row:1/-1;grid-column:1;display:grid;grid-template-rows:subgrid;background:var(--background);min-width:0;position:relative}.query-card[hidden]{display:grid!important;visibility:hidden}
 .query-header{min-height:68px;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;position:relative;border-bottom:1px solid var(--web-outline)}
 .query-name{font:600 14px/20px var(--font-heading)}
 /* The status carries the card (owner, 19 Oct 2026: more emphasis on it): a larger chip with a
    live dot while the query is open, Green with a check once the answer is final. The dot's
    slow opacity pulse runs only on the shown card and not with reduced motion or in print. */
 .query-status{display:inline-flex;align-items:center;gap:10px;padding:8px 14px;background:var(--web-tile);box-shadow:inset 0 0 0 1px var(--web-outline);font:600 15px/20px var(--font-heading);white-space:nowrap}
 .status-dot{width:8px;height:8px;flex:none;background:var(--primary)}
 .query-status.is-pending .status-dot{background:transparent;box-shadow:inset 0 0 0 2px var(--primary)}
 .query-card:not([hidden]) .status-dot{animation:status-live 1.6s ease-in-out infinite}
 @keyframes status-live{50%{opacity:.25}}
 .query-status.is-final{background:var(--primary);box-shadow:none;color:var(--background)}
 .query-status :global(.web-icon),.query-status :global(svg){width:16px;height:16px}
 .query-header::before{content:'';position:absolute;width:80px;height:2px;left:-80px;top:var(--connector-top,43px);background:var(--primary)}
 .query-body{padding:24px 24px 0}.query-body h3{font:400 22px/31px var(--font-heading);margin:0 0 6px;letter-spacing:-.01em}
 /* The five question fields (owner, 19 Oct 2026), each in one place. The title is the heading.
    The information cutoff sits under it at a glance, because it decides which evidence counts.
    The description (how each outcome connects to the question) and the resolution criteria
    (the exact process for verifying the outcome) are long, so they share one disclosure; the
    criteria are a numbered list because they are a process. The outcome list is the board
    below, one tile per outcome. Every card opens and closes together (home-interactions.ts), so
    the shared row never leaves a gap on another step. */
 .query-cutoff{margin:0 0 2px;font-size:13px;line-height:20px;color:var(--muted-foreground)}
 .query-cutoff time{margin-left:6px;font:600 13px/20px var(--font-heading);font-variant-numeric:tabular-nums;color:var(--foreground)}
 .query-details summary{display:inline-flex;align-items:center;gap:8px;min-height:44px;cursor:pointer;list-style:none;font:600 13px/18px var(--font-heading);text-underline-offset:4px}
 .query-details summary::-webkit-details-marker{display:none}
 .query-details summary :global(.web-icon),.query-details summary :global(svg){width:14px;height:14px}
 .query-details summary :global(.web-icon:last-child){transition:transform 180ms var(--ease-reveal)}
 .query-details[open] summary :global(.web-icon:last-child){transform:rotate(180deg)}
 .details-body{display:grid;gap:18px;margin:0 0 12px;padding:16px 18px;background:var(--web-quiet);border-left:2px solid var(--web-outline)}
 .details-field{display:grid;gap:6px}
 .details-field p strong{font-weight:600;color:var(--foreground)}
 .details-label{font:600 12px/16px var(--font-heading);color:var(--muted-foreground);margin:0}
 .details-body p{font-size:14px;line-height:22px;margin:0;max-width:64ch}
 .details-criteria{display:grid;gap:8px;margin:2px 0 0;padding:0;list-style:none;counter-reset:criteria}
 .details-criteria li{display:grid;grid-template-columns:20px minmax(0,1fr);column-gap:12px;max-width:64ch;font-size:14px;line-height:22px;counter-increment:criteria}
 .details-criteria li::before{content:counter(criteria);display:grid;place-items:center;width:20px;height:20px;margin-top:1px;box-shadow:inset 0 0 0 1px var(--web-outline);font:600 11px/1 var(--font-heading);font-variant-numeric:tabular-nums;color:var(--muted-foreground)}
 .details-body .details-unix{font-size:12px;line-height:16px;color:var(--muted-foreground)}
 .details-unix span{margin-left:6px;font:600 12px/16px var(--font-heading);font-variant-numeric:tabular-nums;color:var(--foreground)}
 /* The outcome board (owner, 19 Oct 2026: “rethink … something great”). Answers are not votes:
    each challenge doubles the bond, so the board shows bonds, not shares. Each outcome is a tile
    (name, its bonds as REP squares, the amount); a square is one bond-sized unit, Pewter like the
    REP panel's bonds, Green on the answer that stands, and an empty outline where nothing is
    staked. One Green frame marks the standing answer; it is a single element over the tiles, so
    it can glide from YES to NO when the challenge lands (home-interactions.ts). The label row
    carries the total. */
 .query-outcomes{border-top:1px solid var(--web-outline);margin-top:8px;padding:20px 0 24px}
 .outcomes-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:12px}
 .outcomes-head p{margin:0;font-size:13px;line-height:18px;color:var(--muted-foreground)}
 .stakes-total strong{font:600 16px/22px var(--font-heading);font-variant-numeric:tabular-nums;color:var(--foreground)}
 .outcome-board{--tile-gap:8px;--square:24px;position:relative}
 .outcome-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--tile-gap);list-style:none;margin:0;padding:0}
 .outcome-tile{display:flex;flex-direction:column;align-items:flex-start;gap:12px;min-width:0;padding:14px 16px 16px;background:var(--web-tile)}
 .outcome-head{display:flex;align-items:center;justify-content:space-between;gap:8px;align-self:stretch;min-height:24px}
 .outcome-name{font:600 16px/24px var(--font-heading);color:var(--foreground)}
 .outcome-check{display:flex;color:var(--primary)}.outcome-check :global(.web-icon),.outcome-check :global(svg){width:18px;height:18px}
 .outcome-bonds{display:flex;gap:4px;height:var(--square)}
 .outcome-bonds i{flex:none;width:var(--square);height:var(--square);background:var(--muted-foreground)}
 .outcome-tile.is-selected .outcome-bonds i{background:var(--primary)}
 .outcome-bonds i.is-empty{background:transparent;box-shadow:inset 0 0 0 1px var(--web-outline)}
 .outcome-stake{font:600 15px/20px var(--font-heading);font-variant-numeric:tabular-nums;white-space:nowrap;color:var(--foreground)}
