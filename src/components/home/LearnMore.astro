---
import {homeCopy,type ReviewVariant} from '../../data/homepage-review';
import {navigation} from '../../data/navigation';
import {doorScenes,doorBox} from '../../data/door-scenes';
import type {SvgNode} from '../../data/iso-kit';
import Icon from '../primitives/Icon.astro';
// Each homepage version renders its own copy (homepage-review.ts).
interface Props { variant:ReviewVariant; }
const {variant}=Astro.props;
// Item 6; owner, 26 Oct 2026: sketch A: no questions, three doors, the FAQ, the blog and Discord.
// Each door is one link that fills its tile (the title's link stretches over it), so the accessible
// name stays the title and the door's line describes it. Hrefs come from the navigation directory the
// header and footer use, so the doors can't drift from those menus. No generic icons (owner): each door
// is marked by its own object from the iso kit (door-scenes.ts), drawn here at rest like IsoScene.astro's.
const keep=homeCopy(variant).learnMore.keepGoing;
const discord=navigation.community.find(item=>item.linkKey==='discord')!;
const doors=[
 {id:'faq',...keep.faq,href:navigation.resources.find(item=>item.href==='/faq/')!.href,external:false},
 {id:'blog',...keep.blog,href:navigation.resources.find(item=>item.href==='/blog/')!.href,external:false},
 {id:'community',...keep.community,href:discord.href,external:true},
] as const;
// The section reveal (reveal-v2.js): the heading, the lead, then the doors left to right.
---
<section class="home-learn section" id="learn-more" aria-labelledby="learn-heading"><div class="container">
 <div class="section-heading"><h2 id="learn-heading" data-reveal>{keep.heading}</h2><p class="lead" data-reveal>{keep.lead}</p></div>
 <ul class="doors">{doors.map(door=><li class="door" data-external={door.external?'':undefined} data-reveal="item">
  <svg class="door-art" viewBox={`0 0 ${doorBox.w} ${doorBox.h}`} width={doorBox.w} height={doorBox.h} aria-hidden="true" focusable="false" data-door={door.id}><g transform={doorScenes[door.id].transform}>{(function render(nodes:SvgNode[]):any{return nodes.map(({tag,attrs,children})=>{const Tag=tag as any;return children?<Tag {...attrs}>{render(children)}</Tag>:<Tag {...attrs}/>;});})(doorScenes[door.id].world)}</g></svg><Icon name={door.external?'arrow-up-right':'arrow-right'} class="door-arrow"/>
  <h3 class="door-title"><a class="door-link" href={door.href} aria-describedby={`door-${door.id}`}>{door.title}</a></h3>
  <p class="door-line" id={`door-${door.id}`}>{door.line}</p>
 </li>)}</ul>
</div></section>
<style>
 .home-learn{background:var(--web-band);padding-block:72px 96px}
 @media(max-width:767px){.home-learn{padding-block:64px}}
</style>
