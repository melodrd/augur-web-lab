---
interface Props { title: string; lead: string; }
const { title, lead } = Astro.props;
// An optional picture beside the words (About's stack, 30 Oct 2026). From 1024 it takes the empty space right of
// the text, which gives up width only when it must; below that it sits under the text.
const art = Astro.slots.has('art');
---
<section class:list={['page-hero', { 'has-art': art }]}>
  <div class="container page-hero-content">
    <div class="page-hero-text">
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
      <slot />
    </div>
    {art && <div class="page-hero-art"><slot name="art" /></div>}
  </div>
</section>
<style>
  .page-hero { position:relative; overflow:hidden; padding-block:120px 112px; }
  .page-hero-content { position:relative; }
  h1 { margin:0; font-size:clamp(2.5rem,4.445vw,4rem); line-height:1.125; letter-spacing:-.02em; }
  .lead { max-width:780px; margin:24px 0 0; }
  .page-hero-art { margin-top:40px; }
  @media(min-width:1024px) {
    .has-art .page-hero-content { display:grid; grid-template-columns:minmax(0,780px) auto; justify-content:space-between; align-items:center; column-gap:48px; }
    .page-hero-art { margin-top:0; }
  }
  @media(max-width:767px) { .page-hero { padding-block:64px; } }
</style>
