---
import {makeHeritage} from '../../data/heritage';
interface Props {seed?:number;width?:number;height?:number;class?:string;}
const {seed=2020,width=1440,height=764,class:className}=Astro.props;
const squares=makeHeritage(seed,width,height);
---
<svg class:list={['heritage-field',className]} viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <g class="heritage-base">{squares.map(s=><rect x={s.x} y={s.y} width="3" height="3" fill={s.accent?'var(--primary)':'var(--foreground)'} opacity={s.opacity} />)}</g>
</svg>
<style>
.heritage-field{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
@media print{.heritage-field{display:none}}
</style>
