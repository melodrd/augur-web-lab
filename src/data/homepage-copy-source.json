    {
      "id": "31:51",
      "name": "03 · Hero (Melo's homepage draft, 29 Oct 2026; Figma pending)",
      "text": [
        [
          "31:55",
          "The frontier of\ndecentralized\ntruth."
        ],
        [
          "31:57",
          "Real-world answers for onchain apps, controlled by no one."
        ],
        [
          "melo:hero/1",
          "Augur Lituus is the next generation of Augur’s oracle, one of the most robust ways to put data onchain. Anyone can ask, anyone can answer, anyone can challenge, and lying is designed to cost more than"
        ],
        [
          "melo:hero/2",
          "ever before."
        ],
        [
          "melo:hero/3",
          "For traders"
        ],
        [
          "melo:hero/4",
          "For REP holders"
        ],
        [
          "melo:hero/5",
          "For builders"
        ]
      ]
    },
    {
      "id": "239:474",
      "name": "04 · Why Augur (Melo's homepage draft, 29 Oct 2026; Figma pending)",
      "text": [
        [
          "melo:why/1",
          "Smart contracts"
        ],
        [
          "melo:why/2",
          "can't see the world."
        ],
        [
          "melo:why/3",
          "Whoever controls the oracle decides who gets paid."
        ],
        [
          "melo:why/4",
          "With Augur, no one controls the oracle."
        ],
        [
          "239:485",
          "Permissionless"
        ],
        [
          "melo:why/5",
          "Anyone can ask."
        ],
        [
          "melo:why/6",
          "Anyone can answer."
        ],
        [
          "melo:why/7",
          "Ask, answer or push back. No one has to let you in."
        ],
        [
          "239:495",
          "Trustless"
        ],
        [
          "melo:why/8",
          "No governance."
        ],
        [
          "melo:why/9",
          "No multisigs."
        ],
        [
          "melo:why/10",
          "Trustless all the way: even Augur's creators can't overrule answers."
        ],
        [
          "melo:why/11",
          "Robust"
        ],
        [
          "melo:why/12",
          "Harder to game."
        ],
        [
          "melo:why/13",
          "Costlier to manipulate."
        ],
        [
          "melo:why/14",
          "Designed to cost attackers more than almost any other oracle."
        ],
        [
          "melo:why/15",
          "The answer is nobody's call."
        ],
        [
          "melo:why/16",
          "For traders"
        ],
        [
          "melo:why/17",
          "You've probably seen a market misresolve."
        ],
        [
          "melo:why/18",
          "Here, no authority decides the outcome."
        ],
        [
          "melo:why/19",
          "For builders"
        ],
        [
          "melo:why/20",
          "One bad resolution can turn into a PR disaster."
        ],
        [
          "melo:why/21",
          "With Augur Lituus, your team isn't the judge."
        ]
      ]
    },
